{
  "name": "Sans trace — métadonnées des photos",
  "short_name": "Sans trace",
  "description": "Voir ce que vos photos racontent (lieu, date, appareil) et l’effacer avant de les partager. Tout se passe dans le téléphone.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f1ea",
  "theme_color": "#0f4c4c",
  "categories": ["photo", "utilities"],
  "icons": [
    { "src": "icons/icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icone-masquable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./recevoir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "photos", "accept": ["image/*"] }] }
  }
}
